# Copy to .env and set your credentials:  cp .env.example .env

# ── Active environment: qas | prd ──────────────────────────────
DATABRICKS_ENV=prd

# ── QAS (Personal Access Token) ────────────────────────────────
DATABRICKS_QAS_HOST=dbc-a673d4ad-763e.cloud.databricks.com
DATABRICKS_QAS_HTTP_PATH=/sql/1.0/warehouses/3699fb5411c33d43
DATABRICKS_QAS_TOKEN=dapi_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── PRD (OAuth M2M — Service Principal) ────────────────────────
DATABRICKS_PRD_HOST=dbc-e0db49ed-4e40.cloud.databricks.com
DATABRICKS_PRD_HTTP_PATH=/sql/1.0/warehouses/e4181a34a99570e3
DATABRICKS_PRD_CLIENT_ID=your-client-id
DATABRICKS_PRD_CLIENT_SECRET=your-client-secret

# ── Supabase Configuration (REST API) ─────────────────────────
# QAS Supabase
# SUPABASE_URL=https://cfihfczuvwbulxddbknd.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-qas-service-role-key

# PRD Supabase (default; pipelines con supabase_profile default o sin perfil)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Segundo proyecto Supabase (pipelines con "supabase_profile": "secondary" en pipelines.json)
# URL: Project Settings → API → Project URL
# Clave servidor: en cuentas nuevas suele ser "secret" (sb_secret_...); úsala aquí.
# La clave "publishable" (sb_publishable_...) es para cliente/navegador; no la uses en Lambda ni en el dashboard server-side.
SUPABASE_SECONDARY_URL=https://your-other-project.supabase.co
SUPABASE_SECONDARY_SERVICE_ROLE_KEY=your-secondary-secret-or-service-role-key

# Tercer proyecto Supabase (pipelines con "supabase_profile": "tertiary")
SUPABASE_TERTIARY_URL=https://your-third-project.supabase.co
SUPABASE_TERTIARY_SERVICE_ROLE_KEY=your-tertiary-secret-or-service-role-key

# Base Socio — producción socio Adelca + cartera (pipelines con "supabase_profile": "base_socio")
SUPABASE_BASE_SOCIO_URL=https://your-base-socio-project.supabase.co
SUPABASE_BASE_SOCIO_SERVICE_ROLE_KEY=your-base-socio-secret-or-service-role-key

# ── Sync Configuration (optional) ─────────────────────────────
OVERLAP_DAYS=7
FETCH_SIZE=5000

# Optional: default table when running connector.py as script
# DBX_TABLE=qas.aplicaciones.transportistas_final
